# Entorno — copia a .env y rellena.
# Este archivo es el catálogo completo de configuración (fuente única con src/config.ts).
# Convención: las variables que listan un valor por defecto lo documentan como tal y son
# override-ables (pueden quedar igual o personalizarse); las que listan vacío son imperativas
# o de uso condicional. Ninguna de las que tienen por defecto es obligatoria de setear.

# Servidor HTTP
PORT=3000            # default: 3000
# Interfaz de bind (doc 00 → ítem 14). '0.0.0.0' expone en todas las interfaces.
HOST=localhost       # default: localhost
NODE_ENV=development # default: development

# Firma del access token (HS256). IMPERATIVA — no tiene default.
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Vigencia: access 5-15 min · refresh 7-30 días (doc 00 → ítem 38)
ACCESS_TTL_MINUTES=15   # default: 15
REFRESH_TTL_DAYS=30     # default: 30

# Google OIDC (doc 00 → ítems 43-47)
GOOGLE_CLIENT_ID=       # opcional: habilitar /auth/google (sin value = ruta responde 500 explícito)
# Allowlist de emisores del ID token (separados por coma) — doc 00 → ítem 44
GOOGLE_ISSUER=https://accounts.google.com  # default: https://accounts.google.com
GOOGLE_JWKS_URL=https://accounts.google.com/.well-known/jwks.json  # default: idem

# SQLite (doc 00 → ítems 30-32)
DB_PATH=data/app.sqlite  # default: data/app.sqlite

# CORS allowlist (doc 00 → ítem 49) — separada por comas
CORS_ORIGINS=http://localhost:5173  # default: http://localhost:5173

# Rate limiting (doc 00 → ítems 41, 48-49) — ms y máx de intentos
RATE_LIMIT_WINDOW_MS=60000           # default: 60000
RATE_LIMIT_MAX=30                    # default: 30
RATE_LIMIT_AUTH_WINDOW_MS=60000      # default: 60000
RATE_LIMIT_AUTH_MAX=10               # default: 10

# Magic link (doc 05 → magic link)
# TTL de validez del enlace en minutos (máx 60).
MAGIC_LINK_TTL_MINUTES=15            # default: 15
# Origin público de la API (esquema+host, SIN path) para los emails (login US-09/10, reset US-12).
# Las URLs se componen en código: origin + API_PREFIX + ruta. Opcional; default dev: http://localhost:3000 (HOST:PORT).
PUBLIC_API_ORIGIN=                   # opcional, p.ej. https://api.example.com

# Compromised password screening (NIST 800-63B §5.1.1.2)
# Hashes SHA-1 de la lista top-100k de contraseñas comprometidas (generado con: npm run gen:password-list).
# Si no está seteado: fallback a lista embebida + reglas algorítmicas (secuencias, repetidos).
# Si se setea pero el archivo no existe: warn en arranque + mismo fallback.
LOCAL_PASSWORD_LIST_PATH=data/top-100k-sha1.txt  # default: data/top-100k-sha1.txt