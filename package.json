{
  "name": "signup-login-jwt-uuid-rol-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API signup/login con JWT, UUID y roles — fase 3 (SDD contra docs/03-openapi.yaml)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract": "openapi-typescript docs/03-openapi.yaml -o src/api/contract.ts",
    "gen:password-list": "tsx scripts/topPasswords.ts",
    "promote:admin": "tsx scripts/promoteAdmin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint ."
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "pino-http": "^10.5.0",
    "zod": "^4.5.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
